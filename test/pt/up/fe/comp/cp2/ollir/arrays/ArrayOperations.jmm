import ioPlus;
class ArrayOperations {
    public int func() {
        int[] numbers;
        int sum;
        int i;

        numbers = new int[5];
        numbers[0] = 10;
        numbers[1] = 20;
        numbers[2] = 30;
        numbers[3] = 40;
        numbers[4] = 50;

        sum = 0;
        i = 0;

        while (i < 5) {
            sum = sum + numbers[i];
            i = i + 1;
        }

        return sum;
    }
}